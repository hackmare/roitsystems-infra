# RO IT Systems Infrastructure — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Domain ────────────────────────────────────────────────────────────────────
# Public hostname for the API (no trailing slash)
API_DOMAIN=api.roitsystems.ca

# Anchor Weather app domain
ANCHOR_DOMAIN=anchor-weather.selkietech.ca

# Email for Caddy's ACME/Let's Encrypt TLS certificate
CADDY_EMAIL=m.oger@roitsystems.ca


# ── CouchDB ───────────────────────────────────────────────────────────────────
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me-strong-password

# ── NATS ──────────────────────────────────────────────────────────────────────
# Internal only — no public exposure needed.
#
# Every client authenticates as its own user with a permission set scoped to
# the subjects it actually uses (see infrastructure/nats/nats.conf). Generate
# one distinct value per line:
#
#     for k in AW_BACKEND AW_LLM AW_CONTROL AW_NOTIFY CONTACT_API \
#              CONTACT_WORKER CONTACT_NOTIFY IMAGE_API IMAGE_MAGICK; do
#         echo "NATS_PASS_$k=$(openssl rand -hex 24)"
#     done
#
# These are consumed in two places and MUST match:
#   1. the nats container (infrastructure/docker-compose.yml) — defines the users
#   2. each client's own NATS_URL — nats://<user>:<password>@nats:4222
#
# The server refuses to start if any referenced variable is unset, so a missing
# value fails loudly rather than silently running without authentication.
NATS_PASS_AW_BACKEND=change-me-openssl-rand-hex-24
NATS_PASS_AW_LLM=change-me-openssl-rand-hex-24
NATS_PASS_AW_CONTROL=change-me-openssl-rand-hex-24
NATS_PASS_AW_NOTIFY=change-me-openssl-rand-hex-24
NATS_PASS_CONTACT_API=change-me-openssl-rand-hex-24
NATS_PASS_CONTACT_WORKER=change-me-openssl-rand-hex-24
NATS_PASS_CONTACT_NOTIFY=change-me-openssl-rand-hex-24
NATS_PASS_IMAGE_API=change-me-openssl-rand-hex-24
NATS_PASS_IMAGE_MAGICK=change-me-openssl-rand-hex-24

# MIGRATION ONLY — delete once every client is on its own credentials and the
# no_auth_user line has been removed from nats.conf.
NATS_PASS_LEGACY_OPEN=change-me-openssl-rand-hex-24

# ── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=https://roitsystems.ca

# Google OAuth (set up in Google Cloud Console: https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Admin emails allowed to access /corporate-network pages (comma-separated)
ADMIN_EMAILS=m.oger@roitsystems.ca,morgane@morganeoger.ca

# Session secret for signing auth cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# Rate limiting: max submissions per window
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# ── Worker ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# Optional: webhook URL for future notifications (Signal/Telegram/email relay)
# Leave empty to disable
NOTIFICATION_WEBHOOK_URL=

# ── Notification Service ──────────────────────────────────────────────────────
# Claude API key for message analysis
CLAUDE_API_KEY=change-me-your-claude-api-key

# Resend API key for email notifications
RESEND_API_KEY=change-me-your-resend-api-key

# Email recipient for contact message notifications
NOTIFICATION_EMAIL=m.oger@roitsystems.ca

# Email sender address (must be verified in Resend)
NOTIFICATION_FROM_EMAIL=notifications@roitsystems.ca

# Twilio SMS configuration (optional, leave empty to skip SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_FROM=
